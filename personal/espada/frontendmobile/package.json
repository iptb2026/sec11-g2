{
  "name": "espada-banking-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "android:build": "quasar build -m capacitor -T android --debug",
    "android:install": "adb install -r src-capacitor/android/app/build/outputs/apk/debug/app-debug.apk",
    "android:run": "npm run android:build && npm run android:install"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.0",
    "axios": "^1.7.0",
    "quasar": "^2.17.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@quasar/app-vite": "^2.1.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
